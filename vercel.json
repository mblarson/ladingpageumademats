{
  "redirects": [
    {
      "source": "/pedidoscamiseta",
      "destination": "https://projeto-camiseta.vercel.app/",
      "permanent": false
    },
    {
      "source": "/pedidoscamiseta/:path*",
      "destination": "https://projeto-camiseta.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}